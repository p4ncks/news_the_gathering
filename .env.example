# Docker Compose reads .env. Django itself reads environment variables, not files.
# Copy this file to .env; generate a private key using docs/deployment.md.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Enable only after configuring an HTTPS reverse proxy.
DJANGO_SECURE_SSL_REDIRECT=false
# Trust the forwarded protocol only if your proxy strips client-supplied headers.
DJANGO_TRUST_PROXY=false

# SQLite is the local default and needs no settings. This path is for native
# Python commands. Docker uses its news-data volume at /app/data instead.
# NEWS_DB_PATH=/absolute/path/to/news.db

# PostgreSQL replaces SQLite when set, and wins over NEWS_DB_PATH. Percent-encode
# special characters in the password. TLS is required except on localhost.
# Web on Vercel: the transaction pooler, port 6543.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Collector and migrations: the session pooler, port 5432.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Keep active headlines, plus bounded historical editions and collection runs.
NEWS_RETENTION_DAYS=30
NEWS_MAX_EDITIONS=48
NEWS_FRESHNESS_HOURS=2
NEWS_MIN_FRESH_SOURCES=1
NEWS_SOURCE_TIMEOUT_SECONDS=60
NEWS_MIN_EDITION_RATIO=0.5
